{
	"name": "@hoardodile/plugin-novel",
	"version": "0.1.3",
	"private": true,
	"license": "MIT",
	"type": "module",
	"scripts": {
		"dev": "hoardodile plugin dev --data testdata/text",
		"build": "hoardodile plugin build",
		"watch": "hoardodile plugin build --watch",
		"testdata": "node scripts/make-testdata.mjs",
		"testdata:real": "node --use-env-proxy scripts/fetch-real-samples.mjs && node scripts/verify-real-samples.mjs",
		"detect:smoke": "hoardodile plugin run detect testdata/text --plugin-dir dist",
		"lint": "tsc --noEmit",
		"test": "vitest run",
		"readme:check": "node scripts/check-readme.mjs",
		"release": "node scripts/release.mjs"
	},
	"release-it": {
		"git": {
			"commitMessage": "chore(release): v${version}",
			"tagName": "v${version}",
			"requireBranch": "main"
		},
		"github": {
			"release": false
		},
		"npm": {
			"publish": false,
			"allowSameVersion": true
		},
		"plugins": {
			"@release-it/conventional-changelog": {
				"preset": {
					"name": "conventionalcommits"
				},
				"infile": "CHANGELOG.md"
			}
		},
		"hooks": {
			"after:bump": "node scripts/sync-version.mjs"
		}
	},
	"dependencies": {
		"@hoardodile/sdk-react": "^0.1.6",
		"@hoardodile/sdk-server": "^0.1.6",
		"@hoardodile/sdk-types": "^0.1.6",
		"@hoardodile/sdk-web": "^0.1.6",
		"@hoardodile/ui": "^0.1.6",
		"@solar-icons/react": "^2.1.0",
		"react": "^19.2.8",
		"react-dom": "^19.2.8"
	},
	"devDependencies": {
		"@hoardodile/cli": "^0.1.6",
		"@hoardodile/host": "^0.1.6",
		"@hoardodile/host-web": "^0.1.6",
		"@hoardodile/workbench": "^0.1.6",
		"@tailwindcss/vite": "^4.3.3",
		"@testing-library/jest-dom": "^7.0.0",
		"@testing-library/react": "^16.3.2",
		"@types/node": "^26.1.2",
		"@types/react": "^19.2.18",
		"@types/react-dom": "^19.2.4",
		"@vitejs/plugin-react": "^6.0.5",
		"fflate": "^0.8.3",
		"iconv-lite": "^0.7.3",
		"jsdom": "^30.0.1",
		"shadcn": "^4.19.0",
		"tailwindcss": "^4.3.3",
		"tw-animate-css": "^1.4.0",
		"typescript": "^7.0.2",
		"vite": "^8.2.0",
		"vitest": "^4.1.10",
		"release-it": "^21.0.2",
		"@release-it/conventional-changelog": "^12.0.0"
	}
}
